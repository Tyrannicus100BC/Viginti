#!/bin/bash
set -euo pipefail

usage() {
  echo "Usage: $0 [--package project-relative.icon] [--output project-relative-directory] [--json]" >&2
}

json_escape() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  printf '%s' "$value"
}

output_relative=".enmanner/.build/icon-previews"
requested_package=""
json=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --package)
      shift
      requested_package="${1:-}"
      [[ -n "$requested_package" ]] || { usage; exit 64; }
      ;;
    --output)
      shift
      output_relative="${1:-}"
      [[ -n "$output_relative" ]] || { usage; exit 64; }
      ;;
    --json) json=true ;;
    *) usage; exit 64 ;;
  esac
  shift
done

if [[ "$output_relative" == /* || "$output_relative" == ".." ||
  "$output_relative" == ../* || "$output_relative" == */../* ||
  "$output_relative" == */.. ]]; then
  echo "Error: preview output must stay inside the project." >&2
  exit 1
fi
if [[ "$output_relative" == ".enmanner" ||
  ( "$output_relative" == .enmanner/* &&
    "$output_relative" != ".enmanner/.build" &&
    "$output_relative" != .enmanner/.build/* ) ]]; then
  echo "Error: preview output inside .enmanner must stay under .enmanner/.build." >&2
  echo "  Use the default path or choose a visible project-owned directory." >&2
  exit 1
fi

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
integration_dir="$(cd "$script_dir/.." && pwd)"
project_dir="$(cd "$integration_dir/.." && pwd)"
manifest="$project_dir/enmanner/enmanner.json"

icon_path="$(
  if [[ -n "$requested_package" ]]; then
    printf '%s' "$requested_package"
  else
    /usr/bin/plutil -extract icon.modern raw "$manifest" 2>/dev/null ||
      /usr/bin/plutil -extract icon raw "$manifest" 2>/dev/null ||
      true
  fi
)"
if [[ "$icon_path" != *.icon ]]; then
  echo "Error: icon previews require an Icon Composer .icon package." >&2
  echo "  Configure icon.modern or pass --package enmanner/icon/App.icon." >&2
  exit 1
fi

if [[ "$icon_path" == /* || "$icon_path" == ".." || "$icon_path" == ../* ||
  "$icon_path" == */../* || "$icon_path" == */.. ]]; then
  echo "Error: icon package must stay inside the project." >&2
  exit 1
fi

if [[ -z "$requested_package" ]]; then
  if [[ "$json" == true ]]; then
    "$script_dir/validate" --json >/dev/null
  else
    "$script_dir/validate"
  fi
fi

developer_dir="$(/usr/bin/xcode-select -p 2>/dev/null || true)"
ictool="$developer_dir/../Applications/Icon Composer.app/Contents/Executables/ictool"
if [[ -z "$developer_dir" || ! -x "$ictool" ]]; then
  echo "Error: previewing icon appearances requires current Xcode and Icon Composer." >&2
  exit 1
fi

icon_source="$project_dir/$icon_path"
if [[ ! -d "$icon_source" || ! -f "$icon_source/icon.json" ]]; then
  echo "Error: no valid icon package exists at $icon_path." >&2
  exit 1
fi
output_dir="$project_dir/$output_relative"
mkdir -p "$output_dir"
output_dir="$(cd "$output_dir" && pwd)"
case "$output_dir/" in
  "$project_dir/"*) ;;
  *)
    echo "Error: preview output resolves outside the project." >&2
    exit 1
    ;;
esac

renditions=(Default Dark ClearLight ClearDark TintedLight TintedDark)
filenames=(
  default.png
  dark.png
  clear-light.png
  clear-dark.png
  tinted-light.png
  tinted-dark.png
)

for index in 0 1 2 3 4 5; do
  "$ictool" "$icon_source" \
    --export-image \
    --output-file "$output_dir/${filenames[$index]}" \
    --platform macOS \
    --rendition "${renditions[$index]}" \
    --width 512 \
    --height 512 \
    --scale 1 >/dev/null
done

contact_sheet="$output_dir/contact-sheet.png"
foreground_name="$(
  /usr/bin/plutil -extract groups.0.layers.0.image-name raw \
    "$icon_source/icon.json" 2>/dev/null || true
)"
background_name="$(
  /usr/bin/plutil -extract groups.0.layers.1.image-name raw \
    "$icon_source/icon.json" 2>/dev/null || true
)"
metrics_file="$output_dir/metrics.json"
/usr/bin/xcrun swift - "$output_dir" "$contact_sheet" \
  "$icon_source/Assets/$foreground_name" \
  "$icon_source/Assets/$background_name" "$metrics_file" <<'SWIFT'
import CoreGraphics
import CoreText
import Foundation
import ImageIO
import UniformTypeIdentifiers

func image(at path: String) -> CGImage {
    guard let source = CGImageSourceCreateWithURL(
        URL(fileURLWithPath: path) as CFURL,
        nil
    ), let image = CGImageSourceCreateImageAtIndex(source, 0, nil) else {
        fatalError("Could not decode \(path).")
    }
    return image
}

let outputDirectory = CommandLine.arguments[1]
let contactSheetPath = CommandLine.arguments[2]
let foregroundPath = CommandLine.arguments[3]
let backgroundPath = CommandLine.arguments[4]
let metricsPath = CommandLine.arguments[5]
let filenames = [
    "default.png", "dark.png", "clear-light.png",
    "clear-dark.png", "tinted-light.png", "tinted-dark.png"
]
let labels = [
    "Default", "Dark", "Clear Light",
    "Clear Dark", "Tinted Light", "Tinted Dark"
]
let tile = 512
guard let sheet = CGContext(
    data: nil,
    width: tile * 3,
    height: tile * 2,
    bitsPerComponent: 8,
    bytesPerRow: tile * 3 * 4,
    space: CGColorSpaceCreateDeviceRGB(),
    bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue
) else { fatalError("Could not create icon contact sheet.") }
for (index, filename) in filenames.enumerated() {
    let column = index % 3
    let row = 1 - index / 3
    sheet.draw(
        image(at: "\(outputDirectory)/\(filename)"),
        in: CGRect(x: column * tile, y: row * tile, width: tile, height: tile)
    )
    let labelRect = CGRect(
        x: column * tile + 12,
        y: row * tile + 12,
        width: 132,
        height: 30
    )
    sheet.setFillColor(
        CGColor(
            colorSpace: CGColorSpaceCreateDeviceRGB(),
            components: [0, 0, 0, 0.68]
        )!
    )
    sheet.fill(labelRect)
    let attributes: [CFString: Any] = [
        kCTFontAttributeName: CTFontCreateWithName(
            "Helvetica-Bold" as CFString,
            16,
            nil
        ),
        kCTForegroundColorAttributeName: CGColor(
            colorSpace: CGColorSpaceCreateDeviceRGB(),
            components: [1, 1, 1, 1]
        )!
    ]
    let line = CTLineCreateWithAttributedString(
        CFAttributedStringCreate(
            nil,
            labels[index] as CFString,
            attributes as CFDictionary
        )
    )
    sheet.textPosition = CGPoint(
        x: labelRect.minX + 9,
        y: labelRect.minY + 7
    )
    CTLineDraw(line, sheet)
}
guard let sheetImage = sheet.makeImage(),
      let sheetDestination = CGImageDestinationCreateWithURL(
        URL(fileURLWithPath: contactSheetPath) as CFURL,
        UTType.png.identifier as CFString,
        1,
        nil
      ) else { fatalError("Could not encode icon contact sheet.") }
CGImageDestinationAddImage(sheetDestination, sheetImage, nil)
guard CGImageDestinationFinalize(sheetDestination) else {
    fatalError("Could not write icon contact sheet.")
}

func alphaMetrics(_ image: CGImage) -> (
    coverage: Double,
    bounds: [String: Double],
    cornersOpaque: Bool
) {
    let width = image.width
    let height = image.height
    guard let context = CGContext(
        data: nil,
        width: width,
        height: height,
        bitsPerComponent: 8,
        bytesPerRow: width * 4,
        space: CGColorSpaceCreateDeviceRGB(),
        bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue
    ), let data = context.data else { fatalError("Could not inspect icon layer.") }
    context.draw(image, in: CGRect(x: 0, y: 0, width: width, height: height))
    let bytes = data.bindMemory(to: UInt8.self, capacity: width * height * 4)
    var count = 0
    var minX = width
    var minY = height
    var maxX = -1
    var maxY = -1
    for y in 0..<height {
        for x in 0..<width where bytes[(y * width + x) * 4 + 3] > 0 {
            count += 1
            minX = min(minX, x)
            minY = min(minY, y)
            maxX = max(maxX, x)
            maxY = max(maxY, y)
        }
    }
    let cornerIndexes = [0, width - 1, (height - 1) * width, width * height - 1]
    let cornersOpaque = cornerIndexes.allSatisfy {
        bytes[$0 * 4 + 3] == 255
    }
    let bounds: [String: Double]
    if maxX >= minX && maxY >= minY {
        bounds = [
            "x": Double(minX) / Double(width),
            "y": Double(minY) / Double(height),
            "width": Double(maxX - minX + 1) / Double(width),
            "height": Double(maxY - minY + 1) / Double(height)
        ]
    } else {
        bounds = ["x": 0, "y": 0, "width": 0, "height": 0]
    }
    return (
        Double(count) / Double(width * height),
        bounds,
        cornersOpaque
    )
}

var warnings: [String] = []
var metrics: [String: Any] = [:]
if FileManager.default.fileExists(atPath: foregroundPath),
   FileManager.default.fileExists(atPath: backgroundPath) {
    let foreground = alphaMetrics(image(at: foregroundPath))
    let background = alphaMetrics(image(at: backgroundPath))
    let margin = [
        foreground.bounds["x"]!,
        foreground.bounds["y"]!,
        1 - foreground.bounds["x"]! - foreground.bounds["width"]!,
        1 - foreground.bounds["y"]! - foreground.bounds["height"]!
    ].min()!
    if margin < 0.02 {
        warnings.append("foreground artwork approaches a source-canvas edge")
    }
    if foreground.coverage > 0.8 {
        warnings.append("foreground alpha coverage is unusually high")
    }
    if !background.cornersOpaque {
        warnings.append("background corners are not fully opaque")
    }
    metrics["foreground"] = [
        "alphaCoverage": foreground.coverage,
        "normalizedBounds": foreground.bounds,
        "minimumEdgeMargin": margin
    ]
    metrics["background"] = [
        "alphaCoverage": background.coverage,
        "cornersOpaque": background.cornersOpaque
    ]
} else {
    warnings.append(
        "source-layer metrics are unavailable for this Icon Composer package"
    )
}
metrics["warnings"] = warnings
let metricsData = try JSONSerialization.data(
    withJSONObject: metrics,
    options: [.prettyPrinted, .sortedKeys]
)
try metricsData.write(to: URL(fileURLWithPath: metricsPath), options: .atomic)
SWIFT

if [[ "$json" == true ]]; then
  printf '{"valid":true,"iconPath":"%s","outputDirectory":"%s","appearances":[' \
    "$(json_escape "$icon_path")" "$(json_escape "$output_relative")"
  separator=""
  for index in 0 1 2 3 4 5; do
    printf '%s{"name":"%s","path":"%s/%s"}' \
      "$separator" "${renditions[$index]}" "$output_relative" \
      "${filenames[$index]}"
    separator=","
  done
  printf '],"contactSheet":"%s/contact-sheet.png","metrics":' \
    "$output_relative"
  /bin/cat "$metrics_file"
  printf '}\n'
else
  echo "✓ Rendered Default, Dark, Clear, and Tinted icon appearances"
  echo "  Contact sheet: $output_relative/contact-sheet.png"
  echo "  Structured measurements: $output_relative/metrics.json"
fi
